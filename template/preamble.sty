\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/04/09 Math mistake notebook template]

\usepackage[a4paper,margin=20mm]{geometry}
\usepackage[UTF8]{ctex}
\usepackage{fontspec}
\usepackage{amsmath,amssymb,amsthm}
\usepackage{mathtools}
\usepackage[dvipsnames]{xcolor}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{enumitem}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{array}
\usepackage{tabularx}
\usepackage{needspace}
\usepackage[hidelinks]{hyperref}
\usepackage{xparse}

\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}
\setmonofont{Latin Modern Mono}

\linespread{1.15}
\setlength{\headheight}{15pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}

\definecolor{MistakeAccent}{RGB}{20,50,104}
\definecolor{MistakeLine}{RGB}{214,223,235}
\definecolor{MistakeText}{HTML}{2B3136}
\definecolor{MistakeMuted}{RGB}{108,124,150}
\definecolor{MistakeRemark}{RGB}{170,176,186}
\definecolor{MistakePanel}{HTML}{F3F7FB}

\color{MistakeText}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\mistakeremark}{}
\newcommand{\setmistakeremark}[1]{\gdef\mistakeremark{#1}}
\newcommand{\mistaketitle}{}
\newcommand{\mistakenumber}{}

\fancyhead[L]{}
\fancyhead[R]{\textcolor{MistakeMuted}{\small 第 \thepage\ / \pageref*{LastPage} 页}}
\fancyfoot[R]{\textcolor{MistakeRemark}{\scriptsize 备注：\mistakeremark}}

\titleformat{\section}
  {\Large\bfseries\color{MistakeAccent}}
  {}
  {0pt}
  {}

\titleformat{\subsection}
  {\large\bfseries\color{MistakeAccent}}
  {}
  {0pt}
  {}

\newcommand{\mistakeheader}[2]{%
  {\Large\bfseries\color{MistakeAccent} #1}\hfill{\large\bfseries\color{MistakeAccent} 编号 #2}\par
  \vspace{0.35em}
  {\color{MistakeLine}\rule{\textwidth}{0.8pt}}\par
  \vspace{0.8em}
}

\newcommand{\mistakeblock}[2]{%
  \Needspace{10\baselineskip}
  {\large\bfseries\color{MistakeAccent} #1}\par
  \vspace{0.35em}
  #2\par
  \vspace{0.6em}
}

\newcommand{\mistakeknowledgeblock}[1]{%
  \vspace{0.3em}
  {\large\bfseries\color{MistakeAccent} 知识点相关信息}\par
  \vspace{0.35em}
  {\color{MistakeLine}\rule{\textwidth}{0.6pt}}\par
  \vspace{0.5em}
  #1\par
}

\newcommand{\reviewspace}{%
  \vfill
  {\large\bfseries\color{MistakeAccent} 答题区}\par
  \vspace{0.4em}
  {\color{MistakeLine}\rule{\textwidth}{0.8pt}}\par
  \vspace{0.5em}
  {\color{MistakePanel}\rule{\textwidth}{0.58\textheight}}\par
}

\newenvironment{mistake}[2]{%
  \gdef\mistaketitle{#1}%
  \gdef\mistakenumber{#2}%
  \setmistakeremark{}%
}{}

\newcommand{\mistakeremarktext}[1]{%
  \setmistakeremark{#1}%
}

\NewDocumentEnvironment{problemcontent}{+b}{%
  \clearpage
  \thispagestyle{fancy}
  \mistakeheader{\mistaketitle}{\mistakenumber}
  \mistakeblock{题目}{#1}%
  \reviewspace
  \clearpage
}{}

\NewDocumentEnvironment{solutioncontent}{+b}{%
  \thispagestyle{fancy}
  \mistakeheader{\mistaketitle}{\mistakenumber}
  \mistakeblock{正确解法}{#1}%
}{}

\newcommand{\mistakeknowledge}[1]{%
  \mistakeknowledgeblock{#1}%
}

\setlist[itemize]{leftmargin=1.5em,itemsep=0.2em,topsep=0.2em}
\setlist[enumerate]{leftmargin=1.7em,itemsep=0.2em,topsep=0.2em}
